# ============================================================================
# Waypoint environment variables.
# Copy this file to ".env.local" and fill in your own values.
# NEVER commit .env.local — it holds secrets.
# ============================================================================

# --- Public site URL (used for OG tags / redirects). No trailing slash. ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Anthropic (AI). Get a key at https://console.anthropic.com ---
# Server-only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (database + auth + file storage) ---
# Project Settings → API. The URL and anon key are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key is SECRET — used only by the Lemon Squeezy webhook. Never expose.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Lemon Squeezy (subscriptions) ---
# Settings → API for the key; Store settings for the store ID;
# your product's variant ID from the Products page; webhook secret from Webhooks.
LEMONSQUEEZY_API_KEY=eyJ...
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_VARIANT_ID=678910
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
